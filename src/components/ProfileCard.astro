---
import fs from "node:fs";
import path from "node:path";
import { profile, socialLinks } from "../config/profile";
import Icon from "./Icon.astro";

const links = socialLinks.filter((item) => item.enabled && item.url.trim());
const hasAvatar = profile.avatar
  ? fs.existsSync(path.join(process.cwd(), "public", profile.avatar.replace(/^\//, "")))
  : false;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const avatarUrl = `${base}${profile.avatar.replace(/^\//, "")}`;
const displayName = profile.name || profile.nameEn;
const initials = displayName.trim().slice(0, 2).toUpperCase();
---

<aside class="profile-card reveal" aria-label="Profile">
  <div class="profile-top">
    <div class:list={["avatar-wrap", { placeholder: !hasAvatar }]}>
      {hasAvatar
        ? <img src={avatarUrl} alt={displayName ? `${displayName}'s portrait` : "Portrait"} width="200" height="200" loading="eager" />
        : <span aria-label="Portrait placeholder">{initials || <Icon name="user" size={52} />}</span>}
    </div>
    <div class="profile-identity">
      {displayName ? <h1>{displayName}</h1> : <p class="profile-placeholder">PROFILE</p>}
      {profile.name && profile.nameEn && <p class="name-en">{profile.nameEn}</p>}
      {profile.username && <p class="username">@{profile.username.replace(/^@/, "")}</p>}
      {profile.signature && <p class="signature">{profile.signature}</p>}
    </div>
  </div>

  {(profile.location || profile.email) && (
    <div class="contact-meta">
      {profile.location && (
        <div>
          <Icon name="location" size={16} />
          <span>{profile.location}</span>
        </div>
      )}
      {profile.email && (
        <a href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} />
          <span>{profile.email}</span>
        </a>
      )}
    </div>
  )}

  {links.length > 0 && (
    <div class="social-links" aria-label="Social links">
      {links.map((link) => (
        <a href={link.url} target={link.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener noreferrer" aria-label={link.name} data-tooltip={link.name}>
          <Icon name={link.icon} />
        </a>
      ))}
    </div>
  )}

  {!displayName && !profile.username && !profile.signature && import.meta.env.DEV && (
    <p class="profile-edit-hint" data-nosnippet>Edit <code>src/config/profile.ts</code> to add your profile.</p>
  )}
</aside>
