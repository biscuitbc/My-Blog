---
import { siteConfig } from "../config/site";
import Icon from "./Icon.astro";
const start = siteConfig.copyrightStartYear;
const year = siteConfig.currentYear;
const years = start && String(year) !== start ? `${start}–${year}` : String(year);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div>
    {siteConfig.author && <p>© {years} {siteConfig.author}</p>}
    <p class="built-with">Built with Astro · Designed for quiet reading</p>
  </div>
  <div class="footer-links">
    {siteConfig.repository && <a href={siteConfig.repository} target="_blank" rel="noopener noreferrer"><Icon name="github" />Source</a>}
    {siteConfig.rssEnabled && <a href={`${base}rss.xml`}><Icon name="book" />RSS</a>}
    <a href="#about"><Icon name="arrow-up" />Back to top</a>
  </div>
</footer>
